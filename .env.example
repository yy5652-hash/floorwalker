# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox).
# Allowance only talks to the sandbox API; live credentials are rejected.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Anthropic API key for the agent, the policy compiler and the reviewer.
ANTHROPIC_API_KEY=
ALLOWANCE_AGENT_MODEL=claude-sonnet-5-5
ALLOWANCE_REVIEW_MODEL=claude-sonnet-5-5

# Sandbox personal account that receives demo payouts (Sandbox → Accounts).
DEMO_PAYEE_EMAIL=

PORT=3000
