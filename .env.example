# Allowance's own PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox).
# Demo workspaces run on it, and it bills subscriptions. Each signed-up workspace connects its own
# sandbox app in Settings → PayPal. Allowance only talks to the sandbox API.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI for the agent, the reviewer and the rules compiler: Claude if ANTHROPIC_API_KEY is
# set, otherwise Gemini. Models default to claude-sonnet-5-5 or GEMINI_MODEL.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# ALLOWANCE_AGENT_MODEL=
# ALLOWANCE_REVIEW_MODEL=

# Sandbox personal account that receives demo payouts (Sandbox → Accounts).
DEMO_PAYEE_EMAIL=

PORT=3000
# Public URL of the app; sign-in cookies and passkeys are bound to it.
# ALLOWANCE_BASE_URL=http://localhost:3000

# Optional. Without them Allowance creates a random secret and VAPID keys in data/ on first start.
# BETTER_AUTH_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Where data lives: the core database (accounts, workspaces, keys, webhooks) and one database per workspace.
# ALLOWANCE_CORE_DB=data/core.db
# ALLOWANCE_DATA_DIR=data/ws
# Model calls a visitor may start per hour (agent runs, rule compiles).
# ALLOWANCE_RUNS_PER_HOUR=60
