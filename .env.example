# Floorwalker's own PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox).
# Demo workspaces run on it, and it bills subscriptions. Each signed-up workspace connects its own
# sandbox app in Settings → PayPal. Floorwalker only talks to the sandbox API.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI for the agent, the reviewer and the rules compiler: Claude if ANTHROPIC_API_KEY is
# set, otherwise Gemini. Models default to claude-sonnet-5-5 or GEMINI_MODEL.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# FLOORWALKER_AGENT_MODEL=
# FLOORWALKER_REVIEW_MODEL=

# Sandbox personal account that receives demo payouts (Sandbox → Accounts).
DEMO_PAYEE_EMAIL=

PORT=3000
# Public URL of the app; sign-in cookies and passkeys are bound to it.
# FLOORWALKER_BASE_URL=http://localhost:3000
# FLOORWALKER_* takes precedence; legacy ALLOWANCE_* variables still work.
# Defaults to data/floorwalker.db; uses data/allowance.db if only that file exists.
# FLOORWALKER_DB=data/floorwalker.db

# Optional. Without them Floorwalker creates a random secret and VAPID keys in data/ on first start.
# BETTER_AUTH_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Where data lives: the core database (accounts, workspaces, keys, webhooks) and one database per workspace.
# FLOORWALKER_CORE_DB=data/core.db
# FLOORWALKER_DATA_DIR=data/ws
# Model calls a visitor may start per hour (agent runs, rule compiles).
# FLOORWALKER_RUNS_PER_HOUR=60

# Optional read-only Ask Floorwalker chat. Server-side only; absent key hides the widget.
DEEPSEEK_API_KEY=
# Code default: deepseek-flash (https://api-docs.deepseek.com/quick_start/pricing/).
FLOORWALKER_ASSISTANT_MODEL=deepseek-flash
# Set to "deepseek" to let DeepSeek stand in for the agent, reviewer and rules compiler when the
# provider above fails. It then receives request content, payment facts and rules. Needs DEEPSEEK_API_KEY.
FLOORWALKER_AI_FALLBACK=
FLOORWALKER_FALLBACK_MODEL=deepseek-flash

# Transactional email (server only). Verify this sender in Postmark; never use VITE_ keys.
POSTMARK_SERVER_TOKEN=
FLOORWALKER_MAIL_FROM=Floorwalker <hello@example.com>
# Without a token, http://localhost or http://127.0.0.1 (any port) writes outbox.jsonl
# beside FLOORWALKER_CORE_DB, including in production. Other production URLs require a token.
# Browser flow tests read this file; match it to your server's core database directory.
FLOW_OUTBOX=notes/.next/outbox.jsonl
# Comma-separated emails permitted to view /app#admin and /api/admin/auth-stats.
FLOORWALKER_ADMIN_EMAILS=
# Approval emails and reminders use this same transport. Weekly owner summaries run Monday
# at 09:00 UTC (completed Monday–Monday week); per-user switches are in Notifications.
# Demo workspaces never send these emails. One-tap links expire with the request, within 72 hours.
