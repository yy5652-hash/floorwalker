    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "express": "^5.3.0",
    "helmet": "8.3.0",
